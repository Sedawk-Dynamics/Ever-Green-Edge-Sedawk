# Copy to .env.local for local development, and add the same keys in your host
# (e.g. Vercel → Project → Settings → Environment Variables) for production.
# Without these, local dev still works: OTP code is 123456 and leads are logged to the terminal.

# --- Analytics (optional; each loads only if set) -----------------------------
NEXT_PUBLIC_GA4_ID=            # e.g. G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=     # e.g. 123456789012345

# --- Leads: every form / enrollment / payment record is POSTed here as JSON ----
LEADS_WEBHOOK_URL=             # Google Apps Script, Zapier, Make, or CRM webhook URL
LEADS_WEBHOOK_TOKEN=           # optional; sent as "Authorization: Bearer <token>"

# --- Mobile OTP (Twilio Verify) ----------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_TOKEN_SECRET=              # long random string, e.g. `openssl rand -base64 32`

# --- Payments (Razorpay) -------------------------------------------------------
RAZORPAY_KEY_ID=               # rzp_test_... while testing, rzp_live_... in production
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=       # Razorpay Dashboard → Webhooks → /api/razorpay/webhook, event "order.paid"
